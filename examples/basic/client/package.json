{
  "name": "@grotto-web/example-basic-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "protoc -I ../proto --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/gen --ts_proto_opt=outputServices=default,useAsyncIterable=true,esmInterop=true,importSuffix=.js,useOptionals=messages ../proto/ping/ping.proto",
    "start": "node --import tsx src/index.ts",
    "ping": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@grotto-web/client-web": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "ts-proto": "^2.11.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
